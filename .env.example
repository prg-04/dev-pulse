# Public — safe in client components
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Server-side only — never NEXT_PUBLIC_ prefix on these
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
SUPABASE_CONNECTION_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# AI — provider-agnostic via Vercel AI SDK
# Set AI_PROVIDER explicitly, or let the system infer from AI_MODEL / available keys.
# Generation and embedding can use separate models.
#
# Generic (recommended — works for any provider):
# AI_PROVIDER=openrouter           # openai | anthropic | google | mistral | deepseek | openrouter | ollama | generic
# AI_MODEL=gpt-4o-mini             # model id for generation
# AI_MODEL_EMBEDDING=text-embedding-3-small  # model id for embeddings
# AI_API_KEY=sk-...                # generic API key (or use provider-specific key below)
# AI_BASE_URL=https://api.example.com/v1  # override base URL for OpenAI-compatible providers
#
# Provider-specific keys (all accepted as aliases for AI_API_KEY):
# OPENAI_API_KEY=                     # (legacy) also accepted for openai
# ANTHROPIC_API_KEY=                  # Claude
# GOOGLE_GENERATIVE_AI_API_KEY=       # Gemini (also GOOGLE_API_KEY, GEMINI_API_KEY)
# MISTRAL_API_KEY=                    # Mistral
# DEEPSEEK_API_KEY=                   # DeepSeek
# OPENROUTER_API_KEY=                 # OpenRouter (proxies many models)
# OLLAMA_BASE_URL=http://localhost:11434/v1  # Ollama local
#
# Examples:
# AI_PROVIDER=google GOOGLE_GENERATIVE_AI_API_KEY=... AI_MODEL=gemini-2.5-flash AI_MODEL_EMBEDDING=gemini-embedding-001
# AI_PROVIDER=anthropic ANTHROPIC_API_KEY=... AI_MODEL=claude-sonnet-4-5
# AI_PROVIDER=openrouter OPENROUTER_API_KEY=... AI_MODEL=deepseek/deepseek-chat
# AI_PROVIDER=ollama AI_MODEL=llama3.1
AI_PROVIDER=openrouter
AI_MODEL=openai/gpt-4o-mini
AI_MODEL_EMBEDDING=text-embedding-3-small
AI_API_KEY=
CRON_SECRET=random-string-must-match-Vercel-Cron-Auth-header
YOUTUBE_API_KEY=your-youtube-key
API_KEY_PEPPER=change-this-to-a-long-random-string-distinct-from-CRON_SECRET
GITHUB_TOKEN=ghp_your_pat_public_repo_read_only
RESEND_API_KEY=re_your_resend_key
# Adzuna — free app_id + app_key (https://developer.adzuna.com/docs) — 25/min, 250/day, 2500/month tight quota — scope to us,gb only
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble — POST-only, key embedded in URL path jooble.org/api/{key} — never log URL with key, server-only
JOOBLE_API_KEY=
# The Muse — optional free key (https://www.themuse.com/developers/api/v2) — 500/hr keyless vs 3600/hr with key — register anyway
THEMUSE_API_KEY=

# Tutorial indexer tuning — keep well under ~90-100 skill ceiling (10k/day quota, search.list=100)
WEEKLY_INDEX_BUDGET=40

