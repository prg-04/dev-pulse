# Public — safe in client components
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...

# Server-side only — never NEXT_PUBLIC_ prefix on these
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
SUPABASE_CONNECTION_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
AI_MODEL=ollama/llama3.1
# For staging with Groq (free tier): AI_MODEL=groq/llama-3.3-70b and GROQ_API_KEY=
# For production: AI_MODEL=anthropic/claude-sonnet-4-6
CRON_SECRET=random-string-must-match-Vercel-Cron-Auth-header
YOUTUBE_API_KEY=your-youtube-key

# Tutorial indexer tuning — keep well under ~90-100 skill ceiling (10k/day quota, search.list=100)
WEEKLY_INDEX_BUDGET=40

# Legacy aliases (also supported via lib/supabase/env.ts fallback, but prefer NEXT_PUBLIC_*)
# SUPABASE_PROJECT_URL=https://your-project.supabase.co
# SUPABASE_PERISHABLE_KEY=sb_publishable_xxx
# SUPABASE_ANON_KEY=eyJhbG...
# SUPABASE_SERVICE_SECRET=eyJhbG...
# SUPABASE_SERVICE_KEY=eyJhbG...
# SUPABASE_URL=https://your-project.supabase.co
